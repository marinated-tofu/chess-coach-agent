OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_TIMEOUT_SECONDS=30
COACH_TIMEOUT_SECONDS=60
LOGFIRE_TOKEN=
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_DEPTH=9
MONITORING_LOG_PATH=backend/data/logs/events.jsonl
DATABASE_URL=sqlite:///backend/data/chess_coach.db
ENABLE_LOCAL_EMBEDDINGS=false
# Leave blank to use the retrieval benchmark's checked-in production selection.
RETRIEVAL_STRATEGY=
# Override these when using a model whose rates are not built into the app.
OPENROUTER_INPUT_COST_PER_MILLION=0.10
OPENROUTER_OUTPUT_COST_PER_MILLION=0.50
# Optional "Sign in with Lichess". Signs the session cookie; set a long random value in production.
SESSION_SECRET=
# Any string works for Lichess PKCE apps; shown to the user on the Lichess consent screen.
LICHESS_CLIENT_ID=chess-coach-agent
# Public origin used to build the OAuth redirect URI (e.g. https://your-app.onrender.com).
# Leave blank locally to derive it from the request.
PUBLIC_BASE_URL=
